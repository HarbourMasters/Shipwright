{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Setup CMake Project",
            "type": "shell",
            "windows":{
                "command": "cmake",
                "args": [
                    "-S",
                    ".",
                    "-B",
                    "build/x64",
                    "-G",
                    "Visual Studio 17 2022",
                    "-T",
                    "v143",
                    "-A",
                    "x64"
                ],
            },
            "linux": {
                "command": "cmake",
                "args": [
                    "-H.",
                    "-Bbuild-cmake",
                    "-GNinja"
                ]
            },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Generate SOH OTR",
            "type": "shell",
            "windows": {
                "command": "cmake",
                "args": [
                    "--build",
                    "./build/x64",
                    "--target",
                    "GenerateSohOtr"
                ],
            },
            "linux": {
                "command": "cmake",
                "args": [
                    "--build",
                    "build-cmake",
                    "--target",
                    "GenerateSohOtr",
                    "--parallel"
                ]
            },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Build Project",
            "type": "shell",
            "windows": {
                "command": "cmake",
                "args": [
                    "--build",
                    "./build/x64"
                ],
            },
            "linux": {
                "command": "cmake",
                "args": [
                    "--build",
                    "build-cmake",
                    "--parallel",
                    "8"
                ]
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": ["Generate SOH OTR"],
            "problemMatcher": []
        },
        {
            "label": "Build All",
            "dependsOrder": "sequence",
            "dependsOn": [
                "Setup CMake Project",
                "Generate SOH OTR",
                "Build Project"
            ]
        }
    ]
}