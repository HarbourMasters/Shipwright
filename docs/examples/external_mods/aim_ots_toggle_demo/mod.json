{
  "id": "com.example.aim_ots_toggle_demo",
  "name": "Aim OTS Toggle Demo",
  "version": "0.1.0",
  "apiVersion": 3,
  "loadPriority": 250,
  "entryScript": "scripts/init.json",
  "assets": [],
  "dependencies": [],
  "capabilities": [
    "camera.aim_profiles.v1",
    "behaviors.graph.v1"
  ],
  "runtime": {
    "type": "wasm3-v1",
