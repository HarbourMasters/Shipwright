diff --git a/cmake/dependencies/switch.cmake b/cmake/dependencies/switch.cmake
new file mode 100644
index 00000000..71125b36
--- /dev/null
+++ b/cmake/dependencies/switch.cmake
@@ -0,0 +1,85 @@
+# Nintendo Switch (devkitA64 + libnx) dependencies.
+#
+# Prefer devkitPro's portlibs. Anything not provided there (or provided without a CMake config) is
+# fetched and built from source with OVERRIDE_FIND_PACKAGE, so the plain find_package(... REQUIRED)
+# calls elsewhere in libultraship and the game keep working unchanged.
+
+include(FetchContent)
+
+if(NOT DEFINED DEVKITPRO)
+    if(DEFINED ENV{DEVKITPRO})
+        set(DEVKITPRO $ENV{DEVKITPRO})
+    else()
+        set(DEVKITPRO /opt/devkitpro)
+    endif()
+endif()
+set(SWITCH_PORTLIBS_INCLUDE ${DEVKITPRO}/portlibs/switch/include)
+list(APPEND ADDITIONAL_LIB_INCLUDES ${SWITCH_PORTLIBS_INCLUDE})
+
+set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
+
+#=================== SDL2 + GL ===================
+find_package(SDL2 REQUIRED)
+
+find_library(SWITCH_GLAD_LIBRARY glad PATHS ${DEVKITPRO}/portlibs/switch/lib REQUIRED)
+if(NOT TARGET glad::glad)
+    add_library(glad::glad STATIC IMPORTED GLOBAL)
+    set_target_properties(glad::glad PROPERTIES
+        IMPORTED_LOCATION ${SWITCH_GLAD_LIBRARY}
+        INTERFACE_INCLUDE_DIRECTORIES ${SWITCH_PORTLIBS_INCLUDE}
+        # glad resolves through Mesa's EGL; SDL2 pulls in EGL/glapi/drm_nouveau/nx.
+        INTERFACE_LINK_LIBRARIES SDL2::SDL2
+    )
+endif()
+
+#=================== ImGui ===================
+target_link_libraries(ImGui PUBLIC glad::glad SDL2::SDL2)
+target_include_directories(ImGui PRIVATE ${SWITCH_PORTLIBS_INCLUDE})
+# ImGui's bundled GL loader dlopens libGL, which doesn't exist on the Switch; use glad instead.
+target_compile_definitions(ImGui PRIVATE IMGUI_IMPL_OPENGL_LOADER_CUSTOM)
+set_source_files_properties(${imgui_SOURCE_DIR}/backends/imgui_impl_opengl3.cpp
+    PROPERTIES COMPILE_OPTIONS "-include;glad/glad.h")
+
+#=================== Libraries with source fallbacks ===================
+find_package(ZLIB REQUIRED)
+
+find_package(libzip CONFIG QUIET)
+if(NOT libzip_FOUND)
+    message(STATUS "Switch: libzip not in portlibs, building from source")
+    foreach(_opt ENABLE_BZIP2 ENABLE_LZMA ENABLE_ZSTD ENABLE_OPENSSL ENABLE_GNUTLS ENABLE_MBEDTLS ENABLE_COMMONCRYPTO
+                 ENABLE_WINDOWS_CRYPTO BUILD_TOOLS BUILD_REGRESS BUILD_OSSFUZZ BUILD_EXAMPLES BUILD_DOC LIBZIP_DO_INSTALL)
+        set(${_opt} OFF CACHE BOOL "" FORCE)
+    endforeach()
+    FetchContent_Declare(libzip
+        GIT_REPOSITORY https://github.com/nih-at/libzip.git
+        GIT_TAG v1.11.4
+        OVERRIDE_FIND_PACKAGE)
+    FetchContent_MakeAvailable(libzip)
+endif()
+
+find_package(nlohmann_json CONFIG QUIET)
+if(NOT nlohmann_json_FOUND)
+    message(STATUS "Switch: nlohmann_json not in portlibs, fetching")
+    set(JSON_BuildTests OFF CACHE BOOL "" FORCE)
+    set(JSON_Install OFF CACHE BOOL "" FORCE)
+    FetchContent_Declare(nlohmann_json
+        GIT_REPOSITORY https://github.com/nlohmann/json.git
+        GIT_TAG v3.12.0
+        OVERRIDE_FIND_PACKAGE)
+    FetchContent_MakeAvailable(nlohmann_json)
+endif()
+
+find_package(tinyxml2 CONFIG QUIET)
+if(NOT tinyxml2_FOUND)
+    message(STATUS "Switch: tinyxml2 not in portlibs, building from source")
+    set(tinyxml2_BUILD_TESTING OFF CACHE BOOL "" FORCE)
+    FetchContent_Declare(tinyxml2
+        GIT_REPOSITORY https://github.com/leethomason/tinyxml2.git
+        GIT_TAG 11.0.0
+        OVERRIDE_FIND_PACKAGE)
+    FetchContent_MakeAvailable(tinyxml2)
+endif()
+
+#=================== Threads ===================
+set(THREADS_PREFER_PTHREAD_FLAG ON)
+find_package(Threads REQUIRED)
