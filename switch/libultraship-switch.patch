diff --git a/src/ship/port/switch/SwitchImpl.cpp b/src/ship/port/switch/SwitchImpl.cpp
new file mode 100644
index 00000000..ac9260eb
--- /dev/null
+++ b/src/ship/port/switch/SwitchImpl.cpp
@@ -0,0 +1,263 @@
+#ifdef __SWITCH__
+#include "ship/port/switch/SwitchImpl.h"
+
+#include <switch.h>
+#include <SDL2/SDL.h>
+#include <spdlog/spdlog.h>
+
+#include <cstdarg>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <ctime>
+#include <imgui_internal.h>
+
+#include "libultraship/bridge/consolevariablebridge.h"
+#include "ship/Context.h"
+#include "ship/audio/Audio.h"
+
+namespace Ship {
+const char* SWITCH_CPU_PROFILES[SWITCH_PROFILE_COUNT] = {
+    "Maximum Performance (1785 MHz)", "High Performance (1581 MHz)", "Boost Performance (1224 MHz)",
+    "Stock Performance (1020 MHz)",   "Powersaving Mode 1 (918 MHz)", "Powersaving Mode 2 (816 MHz)",
+    "Powersaving Mode 3 (714 MHz)",
+};
+} // namespace Ship
+
+// All of these are clocks Horizon itself uses (1785 MHz is the official "boost mode" used during loading),
+// so none of them push the hardware beyond what Nintendo ships.
+static const uint32_t SWITCH_CPU_SPEEDS_VALUES[Ship::SWITCH_PROFILE_COUNT] = {
+    1785000000, 1581000000, 1224000000, 1020000000, 918000000, 816000000, 714000000,
+};
+
+static AppletHookCookie sAppletHookCookie;
+static bool sIsRunning = true;
+static bool sHasFocus = true;
+static bool sIsShowingVirtualKeyboard = false;
+static bool sClkrstInitialized = false;
+static bool sSocketsInitialized = false;
+
+static const char* sRandomTexts[] = {
+    "Psst, don't forget to blame Melon",
+    "Potsanity when?",
+    "Why are you acting so random?",
+    "Enough! My ship sails in the morning",
+    "Do you want 2 or 7 of those?",
+    "Lamp oil, rope, bombs you want it, it's yours my friend as long as you have enough rupees",
+    "You can build it yourself",
+    "Made with <3 by the Harbour Masters!",
+    "They say that Kenix is not a developer",
+    "Squadala we're off",
+    "They say one once saw an equals not get set equals",
+    "This is the port all true gamers dock at",
+    "Enhancements? Times Savers? Cheats? You want them? They're yours my friend!",
+    "They say you gotta have the BIIIIG salad",
+    "They say Torch is good software",
+};
+
+static const char* RandomText() {
+    return sRandomTexts[rand() % (sizeof(sRandomTexts) / sizeof(sRandomTexts[0]))];
+}
+
+static void SetCpuClock(uint32_t hz) {
+    if (hosversionBefore(8, 0, 0)) {
+        pcvSetClockRate(PcvModule_CpuBus, hz);
+    } else if (sClkrstInitialized) {
+        ClkrstSession session = { 0 };
+        if (R_SUCCEEDED(clkrstOpenSession(&session, PcvModuleId_CpuBus, 3))) {
+            clkrstSetClockRate(&session, hz);
+            clkrstCloseSession(&session);
+        }
+    }
+}
+
+static void OnAppletHook(AppletHookType hook, void* param) {
+    switch (hook) {
+        case AppletHookType_OnExitRequest:
+            sIsRunning = false;
+            break;
+        case AppletHookType_OnFocusState:
+            sHasFocus = appletGetFocusState() == AppletFocusState_InFocus;
+            if (!sHasFocus) {
+                // Don't burn battery at boosted clocks while sitting on the HOME menu or asleep.
+                SetCpuClock(SWITCH_CPU_SPEEDS_VALUES[Ship::STOCK]);
+            } else {
+                Ship::Switch::ApplyOverclock();
+                // Audio output is lost after resuming from sleep; recreate the SDL audio player.
+                // See https://github.com/HarbourMasters/Shipwright/issues/3317
+                auto audio = Ship::Context::GetRawInstance()->GetAudio();
+                if (audio != nullptr && audio->GetCurrentAudioBackend() == Ship::AudioBackend::SDL) {
+                    SPDLOG_INFO("Restarting SDL audio to work around audio loss on resume");
+                    audio->SetCurrentAudioBackend(Ship::AudioBackend::SDL);
+                }
+            }
+            break;
+        case AppletHookType_OnPerformanceMode:
+        case AppletHookType_OnOperationMode:
+            Ship::Switch::ApplyOverclock();
+            break;
+        default:
+            break;
+    }
+}
+
+static void DetectAppletMode() {
+    AppletType at = appletGetAppletType();
+    if (at == AppletType_Application || at == AppletType_SystemApplication) {
+        return;
+    }
+
+    Ship::Switch::PrintErrorMessageToScreen("\x1b[2;2HYou've launched the Ship while in Applet mode."
+                                            "\x1b[4;2HPlease relaunch while in full-memory mode."
+                                            "\x1b[5;2HHold R when opening any game to enter HBMenu."
+                                            "\x1b[44;2H%s.",
+                                            RandomText());
+}
+
+void Ship::Switch::Init(SwitchPhase phase) {
+    switch (phase) {
+        case PreInitPhase:
+            srand(time(nullptr));
+            DetectAppletMode();
+            break;
+        case PostInitPhase:
+            appletInitializeGamePlayRecording();
+            // Needed for online play (Anchor) and Crowd Control; failure just leaves networking unavailable.
+            sSocketsInitialized = R_SUCCEEDED(socketInitializeDefault());
+#ifdef _DEBUG
+            if (sSocketsInitialized) {
+                nxlinkStdio();
+            }
+#endif
+            appletSetGamePlayRecordingState(true);
+            appletHook(&sAppletHookCookie, OnAppletHook, nullptr);
+            appletSetFocusHandlingMode(AppletFocusHandlingMode_NoSuspend);
+            if (!hosversionBefore(8, 0, 0)) {
+                sClkrstInitialized = R_SUCCEEDED(clkrstInitialize());
+            } else {
+                pcvInitialize();
+            }
+            ApplyOverclock();
+            break;
+    }
+}
+
+void Ship::Switch::Exit() {
+    // Hand the CPU back at stock clocks instead of leaving it boosted after we quit.
+    SetCpuClock(SWITCH_CPU_SPEEDS_VALUES[STOCK]);
+    if (sClkrstInitialized) {
+        clkrstExit();
+        sClkrstInitialized = false;
+    } else if (hosversionBefore(8, 0, 0)) {
+        pcvExit();
+    }
+    appletUnhook(&sAppletHookCookie);
+    appletSetGamePlayRecordingState(false);
+    if (sSocketsInitialized) {
+        socketExit();
+        sSocketsInitialized = false;
+    }
+}
+
+void Ship::Switch::ImGuiSetupFont(ImFontAtlas* fonts) {
+    if (R_FAILED(plInitialize(PlServiceType_User))) {
+        return;
+    }
+
+    PlFontData fontStd;
+    PlFontData fontExt;
+
+    if (R_SUCCEEDED(plGetSharedFontByType(&fontStd, PlSharedFontType_Standard))) {
+        ImFontConfig config;
+        config.FontDataOwnedByAtlas = false;
+        config.MergeMode = true;
+        strcpy(config.Name, "Nintendo Standard");
+        fonts->AddFontFromMemoryTTF(fontStd.address, fontStd.size, 13.0f, &config,
+                                    fonts->GetGlyphRangesCyrillic());
+    }
+
+    if (R_SUCCEEDED(plGetSharedFontByType(&fontExt, PlSharedFontType_NintendoExt))) {
+        // Nintendo button glyphs (A/B/X/Y, sticks, etc).
+        static const ImWchar ranges[] = {
+            0xE000, 0xE06B, 0xE070, 0xE07E, 0xE080, 0xE099, 0xE0A0, 0xE0BA, 0xE0C0, 0xE0D6, 0xE0E0, 0xE0F5, 0xE100,
+            0xE105, 0xE110, 0xE116, 0xE121, 0xE12C, 0xE130, 0xE13C, 0xE140, 0xE14D, 0xE150, 0xE153, 0,
+        };
+        ImFontConfig config;
+        config.FontDataOwnedByAtlas = false;
+        config.MergeMode = true;
+        strcpy(config.Name, "Nintendo Ext");
+        fonts->AddFontFromMemoryTTF(fontExt.address, fontExt.size, 13.0f, &config, ranges);
+    }
+
+    // The shared font memory stays mapped after plExit, so the atlas can keep pointing at it.
+    plExit();
+}
+
+void Ship::Switch::ImGuiProcessEvent(bool wantsTextInput) {
+    if (wantsTextInput) {
+        if (!sIsShowingVirtualKeyboard) {
+            ImGuiInputTextState* state = ImGui::GetInputTextState(ImGui::GetActiveID());
+            if (state != nullptr) {
+                state->ClearText();
+            }
+            sIsShowingVirtualKeyboard = true;
+            SDL_StartTextInput();
+        }
+    } else if (sIsShowingVirtualKeyboard) {
+        sIsShowingVirtualKeyboard = false;
+        SDL_StopTextInput();
+    }
+}
+
+bool Ship::Switch::IsRunning() {
+    return sIsRunning;
+}
+
+bool Ship::Switch::IsDocked() {
+    return appletGetOperationMode() == AppletOperationMode_Console;
+}
+
+void Ship::Switch::GetDisplaySize(int* width, int* height) {
+    if (IsDocked()) {
+        *width = 1920;
+        *height = 1080;
+    } else {
+        *width = 1280;
+        *height = 720;
+    }
+}
+
+void Ship::Switch::ApplyOverclock() {
+    int32_t perfMode = CVarGetInteger(CVAR_SWITCH_PERF_MODE, (int32_t)MAXIMUM);
+    if (perfMode < 0 || perfMode >= SWITCH_PROFILE_COUNT) {
+        perfMode = MAXIMUM;
+    }
+    if (sHasFocus) {
+        SetCpuClock(SWITCH_CPU_SPEEDS_VALUES[perfMode]);
+    }
+}
+
+void Ship::Switch::PrintErrorMessageToScreen(const char* str, ...) {
+    consoleInit(nullptr);
+
+    va_list args;
+    va_start(args, str);
+    vprintf(str, args);
+    va_end(args);
+
+    while (appletMainLoop()) {
+        consoleUpdate(nullptr);
+    }
+
+    consoleExit(nullptr);
+    exit(1);
+}
+
+void Ship::Switch::ThrowMissingOTR(const std::string& otrPath) {
+    PrintErrorMessageToScreen("\x1b[2;2HYou've launched the Ship without the game O2R file."
+                              "\x1b[4;2HPlease relaunch making sure %s exists."
+                              "\x1b[5;2HGenerate it by running SoH 9.3.0 on a PC with your ROM."
+                              "\x1b[44;2H%s.",
+                              otrPath.c_str(), RandomText());
+}
