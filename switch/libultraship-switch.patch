+#pragma once
+
+#include <cstdint>
+#include <string>
+
+#include <imgui.h>
+
+namespace Ship {
+enum SwitchProfiles { MAXIMUM, HIGH, BOOST, STOCK, POWERSAVINGM1, POWERSAVINGM2, POWERSAVINGM3, SWITCH_PROFILE_COUNT };
+
+enum SwitchPhase { PreInitPhase, PostInitPhase };
+
+// Display names for SwitchProfiles, indexed by profile.
+extern const char* SWITCH_CPU_PROFILES[SWITCH_PROFILE_COUNT];
+
+// CVar holding the selected SwitchProfiles value. Matches the name SoH's config updater migrates gSwitchPerfMode to.
+#define CVAR_SWITCH_PERF_MODE "gEnhancements.SwitchPerfMode"
+
+class Switch {
+  public:
+    static void Init(SwitchPhase phase);
+    static void Exit();
+    static void ImGuiSetupFont(ImFontAtlas* fonts);
+    static void ImGuiProcessEvent(bool wantsTextInput);
+    static bool IsRunning();
+    static bool IsDocked();
+    static void GetDisplaySize(int* width, int* height);
+    static void ApplyOverclock();
+    static void ThrowMissingOTR(const std::string& otrPath);
+    static void PrintErrorMessageToScreen(const char* str, ...);
+};
+}; // namespace Ship
